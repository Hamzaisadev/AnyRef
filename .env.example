# Supabase Public & Anon (Client & Server)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role (Server-only admin operations)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# AI Provider Selection ('gemini' | 'claude')
AI_PROVIDER="gemini"

# AI Model Identifier (must be pinned, cannot end in -latest)
# Options:
# - Gemini: 'gemini-2.0-flash' ($0.10 in / $0.40 out), 'gemini-2.5-pro' ($1.25 in / $5.00 out)
# - Claude: 'claude-3-5-sonnet-20241022' or 'claude-3-7-sonnet-20250219' ($3.00 in / $15.00 out)
AI_MODEL="gemini-2.0-flash"
AI_INPUT_PRICE_PER_1M_USD="0.10"
AI_OUTPUT_PRICE_PER_1M_USD="0.40"

# Google AI Studio API Key (Server-only)
GEMINI_API_KEY="AIzaSy..."

# Anthropic Claude API Key (Server-only, optional fallback)
ANTHROPIC_API_KEY=""

# Daily AI Usage & Spending Guards
AI_DAILY_CALL_LIMIT="50"
AI_DAILY_COST_CAP_USD="2.00"

# Upload Constraints
MAX_UPLOAD_MB="10"
